{:paths ["src"]

 ;; The library depends on Clojure alone. Clojure 1.11 is the floor, and the
 ;; tests run on it unless an alias says otherwise.
 :deps  {org.clojure/clojure {:mvn/version "1.11.4"}}

 :aliases
 {;; clojure -X:test, with data.json for the fixtures of Colour.js
  :test {:extra-paths ["test" "test/resources"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       org.clojure/data.json      {:mvn/version "2.5.2"}
                       org.clojure/test.check     {:mvn/version "1.1.3"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test  (the tests in Node), with data.json for
  ;; the macro that inlines the fixtures
  :cljs {:extra-paths   ["test" "test/resources"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
         :extra-deps    {thheller/shadow-cljs    {:mvn/version "3.5.3"}
                         org.clojure/data.json   {:mvn/version "2.5.2"}
                         org.clojure/test.check  {:mvn/version "1.1.3"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -X:demo, a notebook of every part of the library in Clerk, at
  ;; http://localhost:7777, which follows changes to the code
  :demo {:extra-paths ["notebooks"]
         :extra-deps  {io.github.nextjournal/clerk {:mvn/version "0.18.1158"}}
         :exec-fn     nextjournal.clerk/serve!
         :exec-args   {:index       "notebooks/demo.clj"
                       :browse      true
                       :watch-paths ["notebooks" "src"]}}

  ;; clojure -X:demo:static, the notebook as a static page in target/demo
  :static {:exec-fn   nextjournal.clerk/build!
           :exec-args {:paths    ["notebooks/demo.clj"]
                       :index    "notebooks/demo.clj"
                       :out-path "target/demo"}}

  ;; an nREPL for development, e.g. clojure -M:test:nrepl
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts  ["-m" "nrepl.cmdline"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
